services:
   nginx:
     image: nginx:latest
     ports:
      - 80:80
     restart: unless-stopped
     volumes:
       - ./html:/usr/share/nginx/html:ro
     networks:
      - homelab-1
     labels:
      - "traefik.enable=true"
      - "traefik.http.routers.nginx.rule=Host(`nginx.lab`)"
      - "traefik.http.routers.nginx.entrypoints=web"
      - "traefik.http.services.nginx.loadbalancer.server.port=80"
networks:
  homelab-1:
    external: true
